# Server environment variables
# Copy to .env and fill in your values

PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/ecommerce
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/ecommerce

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Clerk (authentication)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Stripe card payments (optional; without a key checkout offers cash on delivery only)
# Use test keys (sk_test_...) in development. A live key is refused unless NODE_ENV=production.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret of the webhook endpoint https://<server>/api/webhooks/stripe
# Local development: `stripe listen --forward-to localhost:5000/api/webhooks/stripe` prints one.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Image uploads (Cloudinary). Without it images are stored on local disk, which does not persist on Vercel.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
